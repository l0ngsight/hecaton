{
  "instance": {
    "hecaton": {
      "config-replacers": {
        "fail-if-value-missing": false,
        "replacers": [
          {
            "class-name": "uk.org.hecaton.config.replacer.EncryptionReplacer",
            "properties": {
              "passwordFile": "password.txt",
              "passwordUserProperties": false,
              "cipherAlgorithm": "DES",
              "keyLengthBits": 64,
              "secretKeyAlgorithm": "DES",
              "secretKeyFactoryAlgorithm": "PBKDF2WithHmacSHA1"
            }
          }
        ]
      }
    }
  },
  "error": null
}
