{
  "instance": {
    "hecaton": {
      "serialization": {
        "portable-version": 0,
        "use-native-byte-order": false,
        "byte-order": "BIG_ENDIAN",
        "data-serializable-factories": [
          {
            "factory-id": 1,
            "class-name": "uk.org.hecaton.examples.DataSerializableFactory"
          }
        ],
        "portable-factories": [
          {
            "factory-id": 1,
            "class-name": "uk.org.hecaton.examples.PortableFactory"
          }
        ],
        "global-serializer": {
          "class-name": "uk.org.hecaton.examples.GlobalSerializerFactory"
        },
        "serializers": [
          {
            "type-class": "uk.org.hecaton.examples.DummyType",
            "class-name": "uk.org.hecaton.examples.SerializerFactory"
          }
        ],
        "check-class-def-errors": true,
        "java-serialization-filter": {
          "defaults-disabled": true,
          "blacklist": {
            "class": [
              "com.acme.app.BeanComparator"
            ]
          },
          "whitelist": {
            "class": [
              "java.lang.String",
              "example.Foo"
            ],
            "package": [
              "com.acme.app",
              "com.acme.app.subpkg"
            ],
            "prefix": [
              "uk.org.hecaton.",
              "java"
            ]
          }
        },
        "allow-override-default-serializers": true,
        "compact-serialization": {
          "serializers": [
            {
              "serializer": "uk.org.hecaton.examples.DummyTypeSerializer"
            }
          ],
          "classes": [
            {
              "class": "uk.org.hecaton.examples.DummyType"
            }
          ]
        }
      }
    }
  },
  "error": null
}
