<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <name>hecaton-hd</name>
    <description>High-Density memory (NATIVE in-memory format): data kept outside the Java heap, using the
        Foreign Function and Memory API</description>
    <artifactId>hecaton-hd</artifactId>
    <packaging>jar</packaging>

    <parent>
        <groupId>uk.org.hecaton</groupId>
        <artifactId>hecaton-root</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <properties>
        <!-- needed for CheckStyle -->
        <main.basedir>${project.parent.basedir}</main.basedir>
        <!-- member module: Java 25 (FFM) -->
        <jdk.version>25</jdk.version>
        <extraVmArgs>--enable-native-access=ALL-UNNAMED</extraVmArgs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>uk.org.hecaton</groupId>
            <artifactId>hecaton</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>uk.org.hecaton</groupId>
            <artifactId>hecaton</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <classifier>tests</classifier>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <!-- Runs core's map test suites with NATIVE as the default map in-memory format -->
            <id>native-suites</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <dependenciesToScan>
                                <dependency>uk.org.hecaton:hecaton:jar:tests</dependency>
                            </dependenciesToScan>
                            <includes>
                                <include>${hd.native.suites}</include>
                            </includes>
                            <systemPropertyVariables>
                                <hecaton.test.map.inMemoryFormat>NATIVE</hecaton.test.map.inMemoryFormat>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <!-- what core's tests use besides core -->
                <dependency>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>commons-lang3</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>com.google.guava</groupId>
                    <artifactId>guava</artifactId>
                    <version>33.5.0-jre</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.codehaus.groovy</groupId>
                    <artifactId>groovy-all</artifactId>
                    <version>2.4.21</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <properties>
                <hd.native.suites>uk/org/hecaton/map/*Test.java</hd.native.suites>
            </properties>
        </profile>
    </profiles>
</project>
