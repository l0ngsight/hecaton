<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The coordinate for applications that embed or run a member (spec §7.3): core plus every
        member module (Java 25+). Modules are added here as they appear (hecaton-hd, -persistence,
        -tiered, -vector).
    -->
    <name>hecaton-member</name>
    <description>Hecaton member with all member modules (Java 25+)</description>
    <artifactId>hecaton-member</artifactId>
    <packaging>pom</packaging>

    <parent>
        <groupId>uk.org.hecaton</groupId>
        <artifactId>hecaton-root</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <properties>
        <main.basedir>${project.parent.basedir}</main.basedir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>uk.org.hecaton</groupId>
            <artifactId>hecaton</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>uk.org.hecaton</groupId>
            <artifactId>hecaton-sql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>uk.org.hecaton</groupId>
            <artifactId>hecaton-hd</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>uk.org.hecaton</groupId>
            <artifactId>hecaton-persistence</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>uk.org.hecaton</groupId>
            <artifactId>hecaton-vector</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>uk.org.hecaton</groupId>
            <artifactId>hecaton-tiered</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jdk-version</id>
                        <configuration>
                            <rules>
                                <enforceBytecodeVersion>
                                    <!-- the member modules (hecaton-hd, hecaton-persistence, hecaton-vector, hecaton-tiered) are Java 25; the client side stays on 17 -->
                                    <maxJdkVersion>25</maxJdkVersion>
                                </enforceBytecodeVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
